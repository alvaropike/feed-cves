# Dependencias
node_modules/

# Build de Vite
dist/

# Datos generados por euvd_sync (se regeneran con: npm run sync)
public/data/*.json

# Estado local: lo que el feed ya ha visto y lo que ya se ha avisado
.vistas.json
.notificado.json
*.tmp

# Variables de entorno y secretos
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*

# Sistema / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Entorno del cron (lleva el token de Telegram)
euvd_env.sh
