# Copia esto a .env y rellena lo que uses: "npm run sync" lo carga solo
# (node --env-file-if-exists). En GitHub Actions no hay .env — allí cada valor
# es un secreto del repo; ver "Dónde corre el sync" en el README.

# Bot de Telegram
TELEGRAM_BOT_TOKEN=
# Chat/grupo por defecto (respaldo si no se define el tema concreto)
TELEGRAM_CHAT_ID=

# Temas del foro por criticidad. El tema va pegado al chat con dos puntos:
# -100XXXXXXXXXX:ID_TEMA (el 7 de -1001234567890:7 es el tema, no otro chat).
TELEGRAM_CHAT_CRITICAS=
TELEGRAM_CHAT_ALTAS=
TELEGRAM_CHAT_MEDIAS=
TELEGRAM_CHAT_BAJAS=
TELEGRAM_CHAT_SIN_PUNTUAR=
TELEGRAM_CHAT_KEV=

# Sala de guardia: fallos de la pasada y avisos de que el feed se ha quedado
# congelado. No la usa el sync, sino el workflow (.github/avisar.sh), así que en
# Actions va como secreto. Sin ella los avisos caen en la sala de KEV o en
# TELEGRAM_CHAT_ID, para que un montaje sin sala propia se entere igual.
TELEGRAM_CHAT_AVISOS=

# Puntuacion minima para notificar (opcional)
TELEGRAM_UMBRAL=

# Clave de la API de NVD (opcional, sube el limite de peticiones)
NVD_API_KEY=

# Modo rapido (1 = solo cambios recientes)
SYNC_RAPIDO=
